HOST=0.0.0.0
PORT=3000
# Leave unset to use the mock receiver at HOST and PORT.
# DELIVERY_TARGET_URL=https://receiver.example/webhooks
DELIVERY_TIMEOUT_MS=3000
MOCK_RECEIVER_STATUS_CODE=200
MOCK_RECEIVER_DELAY_MS=0
OTEL_SERVICE_NAME=webhook-api
OTEL_METRIC_EXPORT_INTERVAL_MS=5000
# Enable temporarily when diagnosing health probes.
OTEL_TRACE_HEALTHCHECKS=false
